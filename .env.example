DATABASE_URL=postgres://open_grocery_list:change-me@localhost:5432/open_grocery_list
APPLE_BUNDLE_ID=com.example.opengrocerylist
# Comma-separated Apple user identifiers. The first administrator must be listed here.
APPLE_ADMIN_SUBS=
PORT=3000
NODE_ENV=development
# Optional. If absent, invitations are still created and the admin receives the code in the API response.
RESEND_API_KEY=
RESEND_FROM=
